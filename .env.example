# Configuración de la instalación.
#
#   cp .env.example .env
#
# Docker Compose lee el `.env` solo, sin decirle nada. Todo lo de aquí tiene un
# valor por defecto prudente, así que **sin `.env` la aplicación funciona igual**:
# esto es para afinarla a la máquina que tengas.
#
# Se leen al arrancar. Después de tocar algo:  docker compose up -d
# (no hace falta `--build`; eso sólo si cambia el código).
#
# Un valor que no sea un número no tumba el servidor: avisa por el log y sigue
# con el valor por defecto. Pero si te equivocas al escribir el NOMBRE de la
# variable no hay aviso ninguno, simplemente no se aplica. Para comprobarlo:
#
#   docker compose config | grep NOMBRE_DE_LA_VARIABLE


# ─── Capacidad ────────────────────────────────────────────────────────────────
# Lo que hay que subir si tu máquina da para más.

# Procesos que atienden peticiones. Cada uno ronda los 300 MB una vez ha cargado
# las bibliotecas. Con memoria de sobra, 2 o 3 dan paralelismo de verdad.
#GUNICORN_WORKERS=1

# Peticiones a la vez dentro de cada proceso. Bastan hilos porque PyMuPDF y
# Pillow sueltan el GIL mientras trabajan.
#GUNICORN_THREADS=4

# Conversiones de ofimática simultáneas en todo el servidor. Cada una arranca su
# propio LibreOffice, que come entre 130 y 350 MB según el documento. Es el
# ajuste que evita que varias personas hagan cola.
#MAX_CONCURRENT_CONVERSIONS=1

# Memoria del contenedor del backend. Es un tope, no una reserva: sólo se gasta
# lo que se use. Ponerlo alto protege al resto de la máquina de un desmadre.
#BACKEND_MEM_LIMIT=1536m


# ─── Plazos ───────────────────────────────────────────────────────────────────
# No hay límite de páginas en ninguna herramienta: lo que las acota es el tiempo.
# Si subes uno de estos, sube también GUNICORN_TIMEOUT, que tiene que ser SIEMPRE
# el mayor de todos. Si no, gunicorn corta la respuesta a medias y el usuario ve
# un error feo en vez de uno explicado.

#OCR_TIMEOUT_SECONDS=240
#PDF_TO_WORD_TIMEOUT_SECONDS=240
#DOC_TO_PDF_TIMEOUT_SECONDS=180

# Cuánto espera una petición a que le toque el turno de conversión.
#CONVERSION_QUEUE_TIMEOUT_SECONDS=45

# El plazo de gunicorn. Mayor que todos los de arriba.
#GUNICORN_TIMEOUT=300


# ─── Archivos ─────────────────────────────────────────────────────────────────

# Tamaño máximo de una petición completa, en MB. Ojo: nginx tiene el suyo
# (`client_max_body_size` en frontend/nginx.conf) y **manda el más bajo de los
# dos**. Subir sólo éste no sirve de nada.
#MAX_CONTENT_LENGTH_MB=50

# Cuánto sobreviven los archivos subidos sin actividad, y cada cuánto pasa el
# recolector que los borra.
#SESSION_TTL_MINUTES=120
#CLEANUP_INTERVAL_MINUTES=15

# Dónde se guardan. En Docker es un volumen, así que no suele tocarse.
#UPLOAD_ROOT=uploads


# ─── Sello de tiempo ──────────────────────────────────────────────────────────
# Sólo se usa si marcas la casilla al firmar. Es la única salida a internet de
# toda la aplicación, y lo único que manda es un resumen del documento.

#TSA_URL=https://freetsa.org/tsr
#TSA_TIMEOUT_SECONDS=15
